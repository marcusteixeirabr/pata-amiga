{
  "expo": {
    "name": "Pata Amiga",
    "slug": "pata-amiga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/images/logo_pata_512.png",
    "scheme": "pataamiga",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "static",
      "backgroundColor": "#fd8932"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo precisa de permissão para acessar as fotos",
          "cameraPermission": "O aplicativo precisa de acesso à camera",
          "colors": {
            "cropToolbarColor": "#000000"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#000000"
            }
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "assets/images/logo_pata_1024.png",
          "imageWidth": 512,
          "resizeMode": "contain",
          "backgroundColor": "#fd8932",
          "dark": {
            "image": "assets/images/logo_pata_1024.png",
            "imageWidth": 512,
            "resizeMode": "contain",
            "backgroundColor": "#fd8932"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
