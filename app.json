{
  "expo": {
    "name": "pata-amiga",
    "slug": "pata-amiga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pataamiga",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo_pata.png",
      "resizeMode": "contain",
      "backgroundColor": "#fd8932"
    },
    "web": {
      "output": "static",
      "backgroundColor": "#fd8932"
    },
    "plugins": [
      "expo-router",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
