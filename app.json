{
  "expo": {
    "name": "Pata Amiga",
    "slug": "pata-amiga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_pata_1024.png",
    "scheme": "pataamiga",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.marcusteixeirabr.pataamiga",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_pata_adaptativo.png",
        "backgroundColor": "#fd8932"
      }
    },
    "web": {
      "output": "static",
      "backgroundColor": "#fd8932"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_pata_adaptativo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fd8932"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo precisa de permissão para acessar as fotos",
          "cameraPermission": "O aplicativo precisa de acesso à camera",
          "colors": {
            "cropToolbarColor": "#000000"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#000000"
            }
          }
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "823ad866-91fd-44c5-a5ad-8f8f352cdcf0"
      }
    },
    "owner": "maev_labs"
  }
}
